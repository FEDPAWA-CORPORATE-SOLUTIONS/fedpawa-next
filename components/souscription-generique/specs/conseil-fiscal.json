{
  "serviceId": "conseil-fiscal",
  "serviceName": "Conseil Juridique et Fiscal",
  "endpoint": "/api/v1/souscription/conseil-fiscal",
  "priceFixedFCFA": 35000,
  "priceLabel": "Forfait Régime Simplifié",
  "contract": true,
  "hideStepper": false,
  "totalSteps": 6,
  "formTitle": "Souscription Conseil Juridique et Fiscal",
  "formSubtitle": "Sécurisez votre entreprise avec FEDPAWA",
  "steps": [
    {
      "id": 1,
      "title": "Situation de l'entreprise",
      "description": "Définissez le régime fiscal et l'activité de votre entreprise.",
      "fields": [
        { "name": "regimeFiscal", "label": "Régime fiscal", "type": "select", "placeholder": "Sélectionner le régime fiscal", "required": true, "errorRequired": "Le régime fiscal est requis", "options": [ "Régime Simplifié", "Régime du Réel / Corporate" ] },
        { "name": "caEstime", "label": "Chiffre d'affaires estimé (FCFA)", "type": "number", "placeholder": "Exemple : 15 000 000", "required": true, "errorRequired": "Le chiffre d'affaires estimé est requis" },
        { "name": "secteur", "label": "Secteur d'activité principal", "type": "select", "placeholder": "Sélectionner le secteur", "required": true, "errorRequired": "Le secteur est requis", "options": [ "Commerce et distribution", "Services aux entreprises / Conseil", "Bâtiment et travaux publics (BTP)", "Agroalimentaire & Agriculture", "Technologie, Numérique & E-commerce", "Santé, Pharmacie & Bien-être", "Éducation, Formation & Coaching", "Transport, Logistique & Import-Export", "Finance, Assurance & Immobilier", "Autre" ] },
        { "name": "description", "label": "Description synthétique des activités", "type": "textarea", "placeholder": "Décrivez brièvement l'objet social de votre entreprise.", "required": true, "errorRequired": "La description est requise", "rows": 4 }
      ]
    },
    {
      "id": 2,
      "title": "Activité",
      "description": "Précisez la taille de votre entreprise et vos obligations déclaratives.",
      "fields": [
        { "name": "nbSalaries", "label": "Nombre de salariés", "type": "number", "placeholder": "Exemple : 5", "required": true, "errorRequired": "Le nombre de salariés est requis" },
        { "name": "nbDeclarationsMensuelles", "label": "Nombre de déclarations mensuelles", "type": "number", "placeholder": "Exemple : 12", "required": true, "errorRequired": "Le nombre de déclarations mensuelles est requis" }
      ]
    },
    {
      "id": 3,
      "title": "Représentant Légal",
      "description": "Désignez le ou les représentants légaux de votre entreprise.",
      "fields": [
        { "name": "civilite", "label": "Civilité", "type": "select", "placeholder": "Sélectionner", "required": true, "errorRequired": "La civilité est requise", "options": [ "Monsieur", "Madame" ] },
        { "name": "nomComplet", "label": "Nom complet (Nom et Prénoms)", "type": "text", "placeholder": "Exemple : Jean Dupont", "required": true, "errorRequired": "Le nom complet est requis" },
        { "name": "fonction", "label": "Fonction / Qualité", "type": "select", "placeholder": "Sélectionner", "required": true, "errorRequired": "La fonction est requise", "options": [ "Gérant / Co-gérant", "Président / Director", "Directeur Général", "Fondateur / Promoteur", "Mandataire / Fondé de pouvoir" ] },
        { "name": "nationalite", "label": "Nationalité", "type": "text", "placeholder": "Exemple : Camerounaise", "required": false },
        { "name": "typePiece", "label": "Type de pièce d'identité", "type": "select", "placeholder": "Sélectionner le type", "required": true, "errorRequired": "Le type de pièce est requis", "options": [ "Carte Nationale d'Identité (CNI)", "Passeport", "Carte de Séjour / Titre de Résidence" ] },
        { "name": "numPiece", "label": "Numéro de la pièce d'identité", "type": "text", "placeholder": "Numéro de la pièce d'identité", "required": true, "errorRequired": "Le numéro de pièce est requis" }
      ]
    },
    {
      "id": 4,
      "title": "Coordonnées & Notification",
      "description": "Fournissez vos coordonnées pour le suivi de votre dossier.",
      "fields": [
        { "name": "email", "label": "Adresse e-mail professionnelle", "type": "email", "placeholder": "vous@entreprise.com", "required": true, "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$", "errorRequired": "L'email est requis", "errorPattern": "Email invalide" },
        { "name": "telephone", "label": "Téléphone principal (WhatsApp)", "type": "tel", "placeholder": "+237 6XX XXX XXX", "required": true, "pattern": "^\\+?[0-9\\s]{9,16}$", "errorRequired": "Le téléphone est requis", "errorPattern": "Téléphone invalide" },
        { "name": "adresse", "label": "Adresse de résidence / Siège actuel", "type": "text", "placeholder": "Exemple : Immeuble X, Quartier Y, Douala", "required": true, "errorRequired": "L'adresse est requise" },
        { "name": "ville", "label": "Ville", "type": "text", "placeholder": "Douala", "required": true, "errorRequired": "La ville est requise" },
        { "name": "pays", "label": "Pays", "type": "select", "placeholder": "", "required": true, "errorRequired": "", "options": [ "Cameroun", "France", "Belgique", "Suisse", "Canada", "Autre" ], "default": "Cameroun" }
      ]
    },
    {
      "id": 5,
      "title": "Choix de la gamme et du pack",
      "description": "Sélectionnez la gamme adaptée à votre régime fiscal, puis le pack et la périodicité.",
      "fields": [
        { "name": "gamme", "label": "Gamme", "type": "select", "placeholder": "Sélectionner la gamme", "required": true, "errorRequired": "La gamme est requise" },
        { "name": "periodicite", "label": "Périodicité", "type": "select", "placeholder": "Sélectionner la périodicité", "required": true, "errorRequired": "La périodicité est requise", "options": [ "mensuel", "semestriel", "annuel" ] },
        { "name": "pack", "label": "Pack", "type": "select", "placeholder": "Sélectionner le pack", "required": true, "errorRequired": "Le pack est requis" }
      ],
      "options": [
        { "id": "heures-supplementaires", "label": "Heures de bureau supplémentaires" },
        { "id": "ligne-telephonique", "label": "Attribution de ligne téléphonique / Standard dédié" },
        { "id": "salle-reunion", "label": "Réservation de salle de réunion / Conférence" }
      ]
    },
    {
      "id": 6,
      "title": "Validation",
      "description": "Confirmez votre demande et validez les conditions avant de procéder au paiement.",
      "checkboxes": [
        { "name": "chkCgv", "label": "J'accepte expressément les Conditions Générales de Vente et la Politique de Confidentialité de FEDPAWA CORPORATE SOLUTIONS SARL.", "required": true, "errorRequired": "Vous devez accepter les CGV" },
        { "name": "chkCadre", "label": "Je reconnais que la prestation de conseil juridique et fiscal est régie par une convention de prestation de services.", "required": true, "errorRequired": "Vous devez accepter le cadre contractuel" },
        { "name": "chkExactitude", "label": "Je certifie sur l'honneur que les informations et documents fournis sont exacts, authentiques et sincères.", "required": true, "errorRequired": "Vous devez certifier l'exactitude des informations" }
      ]
    }
  ],
